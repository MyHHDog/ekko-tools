{
  "id": "ekko-tools",
  "name": "Ekko Tools",
  "version": "0.1.1",
  "apiVersion": 1,
  "description": "可扩展工具插件：翻译、统一收发件箱（163/QQ/Gmail/自建 IMAP/SMTP）与 RSS 阅读",
  "author": {
    "name": "MyHHDog",
    "url": "https://github.com/MyHHDog"
  },
  "repository": "https://github.com/MyHHDog/ekko-tools",
  "homepage": "https://github.com/MyHHDog/ekko-tools",
  "issues": "https://github.com/MyHHDog/ekko-tools/issues",
  "changelog": "https://github.com/MyHHDog/ekko-tools/blob/main/CHANGELOG.md",
  "keywords": [
    "translation",
    "email",
    "rss",
    "toolbox"
  ],
  "license": "MIT",
  "icon": "assets/icon.png",
  "server": "dist/server.mjs",
  "client": "dist/client.mjs",
  "permissions": [
    "api.read",
    "api.write",
    "automation",
    "ui"
  ],
  "views": [
    {
      "id": "translate",
      "title": "翻译",
      "slot": "workspace",
      "icon": "chat",
      "order": 1
    },
    {
      "id": "mail",
      "title": "邮件",
      "slot": "workspace",
      "icon": "folder",
      "order": 2
    },
    {
      "id": "reading",
      "title": "阅读",
      "slot": "workspace",
      "icon": "book",
      "order": 3
    },
    {
      "id": "settings",
      "title": "设置",
      "slot": "workspace",
      "icon": "settings",
      "order": 4
    }
  ],
  "navigation": {
    "main": [
      {
        "viewId": "translate",
        "title": "Ekko Tools",
        "icon": "assets/icon.png",
        "order": -100
      },
      {
        "viewId": "mail",
        "title": "Ekko 邮件",
        "icon": "assets/nav-mail.png",
        "order": -99
      },
      {
        "viewId": "reading",
        "title": "阅读",
        "icon": "book",
        "order": -98
      },
      {
        "viewId": "settings",
        "title": "设置",
        "icon": "settings",
        "order": -97
      }
    ]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "translateProvider": {
        "type": "string",
        "enum": [
          "baidu",
          "deepl",
          "hostModel",
          "openai"
        ],
        "default": "hostModel"
      },
      "baiduAppId": {
        "type": "string"
      },
      "baiduSecret": {
        "type": "string",
        "secret": true
      },
      "openaiBaseUrl": {
        "type": "string"
      },
      "openaiApiKey": {
        "type": "string",
        "secret": true
      },
      "openaiModel": {
        "type": "string"
      },
      "deeplApiKey": {
        "type": "string",
        "secret": true
      },
      "vaultPassphrase": {
        "type": "string",
        "secret": true
      },
      "maxAttachmentMB": {
        "type": "number",
        "default": 10,
        "minimum": 1,
        "maximum": 25
      },
      "timeoutMs": {
        "type": "number",
        "default": 20000,
        "minimum": 3000,
        "maximum": 100000
      }
    }
  }
}
